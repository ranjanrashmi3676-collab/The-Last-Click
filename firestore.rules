rules_version = '2';

// The Last Click — Firestore security rules
// Copy this into Firebase Console → Firestore Database → Rules, or deploy
// via the Firebase CLI (`firebase deploy --only firestore:rules`).

service cloud.firestore {
  match /databases/{database}/documents {

    // The single shared world document. Anyone signed in (anonymously or
    // otherwise) can read it and update it — but only by incrementing the
    // click counter, never by decrementing it or rewriting history.
    match /world/state {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.totalClicks == resource.data.totalClicks + 1;
    }

    // Append-only public log of every click. No one may edit or delete
    // a click once it's written — the world's history is permanent.
    match /clickEvents/{eventId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Each visitor owns exactly one user/profile document, keyed by their
    // anonymous auth uid. Anyone can read (for the leaderboard); only the
    // owner can write their own document.
    match /users/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Lightweight presence heartbeats used for the "online now" count.
    match /presence/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
